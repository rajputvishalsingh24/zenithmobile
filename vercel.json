{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/events/(.*)",
      "destination": "/api/events"
    },
    {
      "source": "/api/registrations/(.*)",
      "destination": "/api/registrations"
    },
    {
      "source": "/admin",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/admin.html",
      "destination": "/frontend/admin.html"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}
